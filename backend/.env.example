# Local default is SQLite. Use Postgres when running more than one worker.
# DATABASE_URL=sqlite:///./sentinel_gateway.db
# DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@127.0.0.1:5432/sentinel_gateway

# Shared store for rate limits, burst history, runtime switches, and live events.
# Leave unset to keep those same rules in process memory.
REDIS_URL=redis://127.0.0.1:6379/0

# Email every active organization member when a new threat is opened.
# Leave SMTP_HOST empty to keep detection running without sending mail.
ALERT_EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@sentinel.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
DASHBOARD_BASE_URL=http://localhost:5173

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
CACHE_TTL_SECONDS=2
GATEWAY_ENABLED_BY_DEFAULT=true
